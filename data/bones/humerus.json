    "landmarks": [
        {
            "id": "head-of-humerus",
            "name": "Head of the humerus",
            "desc": "Smooth hemispherical surface that articulates with the glenoid cavity and suggests the rounded cap of the shoulder."
        },
        {
            "id": "greater-tubercle",
            "name": "Greater tubercle",
            "desc": "Prominent lateral mass where the rotator cuff tendons converge, giving the shoulder breadth."
        },
        {
            "id": "lesser-tubercle",
            "name": "Lesser tubercle",
            "desc": "Anterior bump that marks the insertion of subscapularis and hints at the bicipital groove."
        },
        {
            "id": "bicipital-groove",
            "name": "Bicipital groove",
            "desc": "Intertubercular sulcus guiding the tendon of the long head of biceps and channels the upper arm's highlight."
        },
        {
            "id": "deltoid-tuberosity",
            "name": "Deltoid tuberosity",
            "desc": "Roughened lateral ridge halfway down the shaft where the deltoid inserts, anchoring the arm's tapering mass."
        },
        {
            "id": "radial-groove",
            "name": "Radial groove",
            "desc": "Posterior spiral groove that carries the radial nerve between the medial and lateral heads of triceps."
        },
        {
            "id": "posterior-humerus-superior-to-radial-groove",
            "name": "Posterior humerus superior to radial groove",
            "desc": "Smooth triangular surface above the radial groove that anchors the lateral head of triceps."
        },
        {
            "id": "posterior-humerus-inferior-to-radial-groove",
            "name": "Posterior humerus inferior to radial groove",
            "desc": "Broad posterior plane below the radial groove where the medial head of triceps attaches."
        },
        {
            "id": "medial-epicondyle",
            "name": "Medial epicondyle",
            "desc": "Large medial projection at the distal end, easily palpated and home to many flexor origins."
        },
        {
            "id": "lateral-epicondyle",
            "name": "Lateral epicondyle",
            "desc": "Smaller lateral projection providing the anchor for the common extensor tendon."
        },
        {
            "id": "trochlea",
            "name": "Trochlea",
            "desc": "Medial spool-shaped articular surface that receives the ulna and defines the hinge of the elbow."
        },
        {
            "id": "capitulum",
            "name": "Capitulum",
            "desc": "Rounded lateral condyle that meets the radial head and gives the distal humerus its spherical contour."
        }
    ],
