    "landmarks": [
        {
            "id": "head-of-femur",
            "name": "Head of the femur",
            "desc": "Rounded articular sphere that nests into the acetabulum and anchors the thigh's sweeping arc."
        },
        {
            "id": "femoral-neck",
            "name": "Neck of the femur",
            "desc": "Constricted bridge angling the head toward the shaft and setting the tilt of the thigh."
        },
        {
            "id": "greater-trochanter",
            "name": "Greater trochanter",
            "desc": "Lateral bony knob palpable at the hip, marking the leverage of abductors and external rotators."
        },
        {
            "id": "lesser-trochanter",
            "name": "Lesser trochanter",
            "desc": "Medial posterior prominence where the iliopsoas tendon tucks under the pelvis."
        },
        {
            "id": "intertrochanteric-crest",
            "name": "Intertrochanteric crest",
            "desc": "Posterior ridge linking the trochanters and catching light as it turns into the shaft."
        },
        {
            "id": "gluteal-tuberosity",
            "name": "Gluteal tuberosity",
            "desc": "Rough lateral strip descending from the greater trochanter where the gluteus maximus grips."
        },
        {
            "id": "linea-aspera",
            "name": "Linea aspera",
            "desc": "Long posterior ridge that receives the thigh adductors and sculpts the posterior column."
        },
        {
            "id": "medial-condyle",
            "name": "Medial condyle",
            "desc": "Medial roller of the distal femur that broadens the knee and supports the semimembranosus insertion."
        },
        {
            "id": "lateral-condyle",
            "name": "Lateral condyle",
            "desc": "Lateral articular mass that meets the tibia and gives the knee its rounded contour."
        },
        {
            "id": "medial-epicondyle-femur",
            "name": "Medial epicondyle",
            "desc": "Projecting knob above the medial condyle that anchors the medial collateral ligament."
        },
        {
            "id": "lateral-epicondyle-femur",
            "name": "Lateral epicondyle",
            "desc": "Broad lateral flare providing attachment for the fibular collateral ligament."
        },
        {
            "id": "adductor-tubercle",
            "name": "Adductor tubercle",
            "desc": "Medial summit just above the condyle where the adductor magnus tendon ends."
        },
        {
            "id": "patellar-surface",
            "name": "Patellar surface",
            "desc": "Anterior groove guiding the patella and catching highlights across the knee."
        }
    ],
