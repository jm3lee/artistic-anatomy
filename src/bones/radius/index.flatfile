desc
"""
Rough anterior projection where {{ linkicon('bc') }} inserts.
"""
]
[
name
Interosseous border <a id="interosseous-border" href="#interosseous-border"><small>#</small></a>
desc
"""
Sharp {{ link('medial') }} edge along the shaft for interosseous membrane attachment.
"""
]
[
name
Ulnar notch <a id="ulnar-notch" href="#ulnar-notch"><small>#</small></a>
desc
"""
Distal {{ link('medial') }} concavity articulating with the head of the {{ linkicon('ulna') }}.
"""
]
[
name
Dorsal tubercle <a id="dorsal-tubercle" href="#dorsal-tubercle"><small>#</small></a>
desc
"""
Posterior distal bump, also called Lister's tubercle, guiding extensor pollicis longus.
"""
]
[
name
Styloid process <a id="styloid-process" href="#styloid-process"><small>#</small></a>
desc
"""
Pointed distal projection anchoring the radial collateral ligament and {{ linkicon('brr') }}.
"""
]
