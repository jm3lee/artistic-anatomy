{#--
  Macro: def_list
  Renders a <dt>/<dd> list for any label + sequence of items.
  - label: the term to show in <dt>
  - items: sequence of objects to render via render_jinja()
--#}
{% macro def_list(label, items) %}
    <dt>{{ label }}</dt>
    {% for item in items %}
        <dd>{{ render_jinja(item) }}</dd>
    {% endfor %}
{% endmacro %}

{#--
  Macro: summary
  Outputs a Markdown “Summary” section with an HTML <dl> of Origins,
  Insertions, and Actions for the given name.
--#}
{% macro summary(name) %}
## Summary

```{=html}
<dl>
    {{ def_list("Origins",     get_origins(name)) }}
    {{ def_list("Insertions",  get_insertions(name)) }}
    {{ def_list("Actions",     get_actions(name)) }}
</dl>
```
{% endmacro %}

